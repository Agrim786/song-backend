# ---- server ----
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGINS=*
# How many proxies sit in front of the API (nginx/Cloudflare). Needed for correct client IPs in rate limiting.
TRUST_PROXY=1

# ---- templates ----
TEMPLATES_DIR=./templates
# Languages are whatever the templates cover (GET /v1/languages); add templates to add one.
# Public URL of template audio for the app's instant intro (defaults to this API's /files/templates).
TEMPLATES_PUBLIC_BASE_URL=

# ---- singing provider ----
# mock = calibrated simulator (use for load tests). elevenlabs = real API.
SINGING_PROVIDER=mock
ELEVENLABS_API_KEY=
# Must equal the provider's concurrency limit (ElevenLabs Creator = 2, measured).
PROVIDER_CONCURRENCY=2
# Seconds of template context sent around each name slot (clip mode). 1000 tested clean.
CLIP_CONTEXT_MS=1000
# Starting estimate for ETA math; replaced by a live moving average once songs complete.
SECONDS_PER_SONG_ESTIMATE=3.5
# When the line is long, sing up to this many names in one provider call (measured: 5 = 2.3x throughput).
MAX_NAMES_PER_CALL=5

# ---- mock provider (calibrated to measured ElevenLabs numbers) ----
MOCK_LATENCY_MS=3300
# Added per extra sung section in one call (5 names = 10 sections took ~7.1 s on the real API).
MOCK_LATENCY_PER_EXTRA_SECTION_MS=475
MOCK_CONCURRENCY=2
MOCK_FAIL_RATE=0

# ---- speech to text ----
STT_PROVIDER=mock
SARVAM_API_KEY=
STT_MAX_PER_MINUTE=60

# ---- spike behaviour ----
# Above this queue ETA the picker prefers already-made songs and the spike set.
SPIKE_ETA_SECONDS=30
# Above this wait the app shows "come back in a bit" instead of a countdown.
LATER_AFTER_SECONDS=60

# ---- storage ----
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/files
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- abuse protection ----
# Per user: keyed on the X-Device-Id header the app sends (random id made at install),
# or the IP when it's missing. Indian carriers put thousands of users behind one IP.
RATE_LIMIT_SONGS_PER_MIN=20
RATE_LIMIT_READS_PER_MIN=240
# Backstop per IP across all /v1 calls. High on purpose (carrier NAT); stops one machine faking device ids.
RATE_LIMIT_IP_PER_MIN=20000
# Set only on staging for k6: requests with this X-Loadtest-Token skip the per-IP limiter.
LOADTEST_TOKEN=

# ---- workers ----
WORKER_METRICS_PORT=9100
